				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"folderPath": "tablescopy",
						"fileSystem": "bulkcopy"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
